# Demo Trajectory Generator - Environment Variables
# Copy this file to .env and set your values

# Password for web UI access (leave empty to disable authentication)
# Recommended for any deployment outside localhost
APP_PASSWORD=

# Optional: Cesium Ion token for enhanced 3D imagery
# Get a free token at https://cesium.com/ion/signup
# If not set, will use default Cesium imagery
CESIUM_ION_TOKEN=

# Optional: Path to vehicle configuration file
# Default: ./vehicle_config.yaml
# VEHICLE_CONFIG_PATH=/path/to/custom/config.yaml
